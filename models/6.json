  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(height_enabled*height_weight*height_reference+machine_enabled*machine_weight*machine_reference+space_enabled*space_weight*space_reference+work_enabled*work_weight*work_reference+special_enabled*special_weight*special_reference)/max(0.001,height_enabled*height_weight+machine_enabled*machine_weight+space_enabled*space_weight+work_enabled*work_weight+special_enabled*special_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "height_factor",
      "label": "高处作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "height_enabled*height_reference*max(0,1+height_elasticity*(production_pressure-1))/(1+height_control*max(0,governance_level-1))",
      "measure": "核查高处作业方案、防坠设施和安全带挂设。"
    },
    {
      "name": "machine_factor",
      "label": "机械设备防护风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "machine_enabled*machine_reference*max(0,1+machine_elasticity*(production_pressure-1))/(1+machine_control*max(0,governance_level-1))",
      "measure": "完善防护联锁、停机上锁和检修能量隔离。"
    },
    {
      "name": "space_factor",
      "label": "有限空间作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "space_enabled*space_reference*max(0,1+space_elasticity*(production_pressure-1))/(1+space_control*max(0,governance_level-1))",
      "measure": "落实有限空间辨识、通风检测、监护与应急救援。"
    },
    {
      "name": "work_factor",
      "label": "危险作业管理风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "work_enabled*work_reference*max(0,1+work_elasticity*(production_pressure-1))/(1+work_control*max(0,governance_level-1))",
      "measure": "核查危险作业许可、承包协调、岗位资格与监护。"
    },
    {
      "name": "special_factor",
      "label": "特殊生产工艺风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "special_enabled*special_reference*max(0,1+special_elasticity*(production_pressure-1))/(1+special_control*max(0,governance_level-1))",
      "measure": "按实际工艺核查粉尘防爆、涉氨检测隔离或熔融金属防水防泄漏。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(height_weight*height_factor+machine_weight*machine_factor+space_weight*space_factor+work_weight*work_factor+special_weight*special_factor)/max(0.001,height_enabled*height_weight+machine_enabled*machine_weight+space_enabled*space_weight+work_enabled*work_weight+special_enabled*special_weight)+coupling*(work_factor*(height_factor+space_factor))"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "height": "高处作业风险",
    "machine": "机械设备防护风险",
    "space": "有限空间作业风险",
    "work": "危险作业管理风险",
    "special": "特殊生产工艺风险"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
