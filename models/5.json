  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(staffing_enabled*staffing_weight*staffing_reference+charge_enabled*charge_weight*charge_reference+mix_enabled*mix_weight*mix_reference+ignition_enabled*ignition_weight*ignition_reference+inventory_enabled*inventory_weight*inventory_reference)/max(0.001,staffing_enabled*staffing_weight+charge_enabled*charge_weight+mix_enabled*mix_weight+ignition_enabled*ignition_weight+inventory_enabled*inventory_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "staffing_factor",
      "label": "超员作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "staffing_enabled*staffing_reference*max(0,1+staffing_elasticity*(production_pressure-1))/(1+staffing_control*max(0,governance_level-1))",
      "measure": "按工房定员组织生产，核查人员进出和隔离要求。"
    },
    {
      "name": "charge_factor",
      "label": "超药量作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "charge_enabled*charge_reference*max(0,1+charge_elasticity*(production_pressure-1))/(1+charge_control*max(0,governance_level-1))",
      "measure": "执行工房限药量与工序限量，核查现场药物周转。"
    },
    {
      "name": "mix_factor",
      "label": "混装药作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "mix_enabled*mix_reference*max(0,1+mix_elasticity*(production_pressure-1))/(1+mix_control*max(0,governance_level-1))",
      "measure": "核查配混装药工艺、设备隔离与操作约束。"
    },
    {
      "name": "ignition_factor",
      "label": "静电及火源控制风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "ignition_enabled*ignition_reference*max(0,1+ignition_elasticity*(production_pressure-1))/(1+ignition_control*max(0,governance_level-1))",
      "measure": "核查防静电接地、工具与火源控制。"
    },
    {
      "name": "inventory_factor",
      "label": "危险品库存管理风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "inventory_enabled*inventory_reference*max(0,1+inventory_elasticity*(production_pressure-1))/(1+inventory_control*max(0,governance_level-1))",
      "measure": "控制库存及堆放，检查安全距离和分库存放。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(staffing_weight*staffing_factor+charge_weight*charge_factor+mix_weight*mix_factor+ignition_weight*ignition_factor+inventory_weight*inventory_factor)/max(0.001,staffing_enabled*staffing_weight+charge_enabled*charge_weight+mix_enabled*mix_weight+ignition_enabled*ignition_weight+inventory_enabled*inventory_weight)+coupling*(staffing_factor*charge_factor)"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "staffing": "超员作业风险",
    "charge": "超药量作业风险",
    "mix": "混装药作业风险",
    "ignition": "静电及火源控制风险",
    "inventory": "危险品库存管理风险"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
