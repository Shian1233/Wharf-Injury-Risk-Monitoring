  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(process_enabled*process_weight*process_reference+seal_enabled*seal_weight*seal_reference+storage_enabled*storage_weight*storage_reference+work_enabled*work_weight*work_reference)/max(0.001,process_enabled*process_weight+seal_enabled*seal_weight+storage_enabled*storage_weight+work_enabled*work_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "process_factor",
      "label": "危险工艺控制风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "process_enabled*process_reference*max(0,1+process_elasticity*(production_pressure-1))/(1+process_control*max(0,governance_level-1))",
      "measure": "复核工艺控制、报警联锁和异常停车处置。"
    },
    {
      "name": "seal_factor",
      "label": "腐蚀与密封失效风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "seal_enabled*seal_reference*max(0,1+seal_elasticity*(production_pressure-1))/(1+seal_control*max(0,governance_level-1))",
      "measure": "开展设备完整性、腐蚀监测和泄漏点闭环检修。"
    },
    {
      "name": "storage_factor",
      "label": "危险物质储存风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "storage_enabled*storage_reference*max(0,1+storage_elasticity*(production_pressure-1))/(1+storage_control*max(0,governance_level-1))",
      "measure": "核查介质相容性、储量、围堰与储存条件。"
    },
    {
      "name": "work_factor",
      "label": "特殊作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "work_enabled*work_reference*max(0,1+work_elasticity*(production_pressure-1))/(1+work_control*max(0,governance_level-1))",
      "measure": "落实特殊作业许可、能量隔离、检测和监护。"
    },
    {
      "name": "detection_factor",
      "label": "泄漏检测与处置能力",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "detection_enabled*min(1,detection_reference*safety_effort)",
      "measure": "测试泄漏检测报警、自动切断与应急响应有效性。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(process_weight*process_factor+seal_weight*seal_factor+storage_weight*storage_factor+work_weight*work_factor)/max(0.001,process_enabled*process_weight+seal_enabled*seal_weight+storage_enabled*storage_weight+work_enabled*work_weight)+coupling*(process_factor*seal_factor)"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)*(1-0.7*detection_factor)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "process": "危险工艺控制风险",
    "seal": "腐蚀与密封失效风险",
    "storage": "危险物质储存风险",
    "work": "特殊作业风险",
    "detection": "泄漏检测与处置能力"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
