  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(well_enabled*well_weight*well_reference+pipeline_enabled*pipeline_weight*pipeline_reference+h2s_enabled*h2s_weight*h2s_reference+pressure_enabled*pressure_weight*pressure_reference+maintenance_enabled*maintenance_weight*maintenance_reference)/max(0.001,well_enabled*well_weight+pipeline_enabled*pipeline_weight+h2s_enabled*h2s_weight+pressure_enabled*pressure_weight+maintenance_enabled*maintenance_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "well_factor",
      "label": "井控风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "well_enabled*well_reference*max(0,1+well_elasticity*(production_pressure-1))/(1+well_control*max(0,governance_level-1))",
      "measure": "检查井控屏障、防喷器和异常溢流处置能力。"
    },
    {
      "name": "pipeline_factor",
      "label": "设备及管线泄漏风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "pipeline_enabled*pipeline_reference*max(0,1+pipeline_elasticity*(production_pressure-1))/(1+pipeline_control*max(0,governance_level-1))",
      "measure": "开展腐蚀检测、密封和管线完整性检查，闭环检维修。"
    },
    {
      "name": "h2s_factor",
      "label": "硫化氢暴露风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "h2s_enabled*h2s_reference*max(0,1+h2s_elasticity*(production_pressure-1))/(1+h2s_control*max(0,governance_level-1))",
      "measure": "核查硫化氢检测、呼吸防护、撤离路线及应急演练。"
    },
    {
      "name": "pressure_factor",
      "label": "高压作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "pressure_enabled*pressure_reference*max(0,1+pressure_elasticity*(production_pressure-1))/(1+pressure_control*max(0,governance_level-1))",
      "measure": "核查压力监测、泄压保护和高压作业隔离。"
    },
    {
      "name": "maintenance_factor",
      "label": "检维修及动火风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "maintenance_enabled*maintenance_reference*max(0,1+maintenance_elasticity*(production_pressure-1))/(1+maintenance_control*max(0,governance_level-1))",
      "measure": "落实隔离置换、气体检测、动火许可与作业监护。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(well_weight*well_factor+pipeline_weight*pipeline_factor+h2s_weight*h2s_factor+pressure_weight*pressure_factor+maintenance_weight*maintenance_factor)/max(0.001,well_enabled*well_weight+pipeline_enabled*pipeline_weight+h2s_enabled*h2s_weight+pressure_enabled*pressure_weight+maintenance_enabled*maintenance_weight)+coupling*(pressure_factor*pipeline_factor)"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "well": "井控风险",
    "pipeline": "设备及管线泄漏风险",
    "h2s": "硫化氢暴露风险",
    "pressure": "高压作业风险",
    "maintenance": "检维修及动火风险"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
