  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(gas_enabled*gas_weight*gas_reference+roof_enabled*roof_weight*roof_reference+water_enabled*water_weight*water_reference+mining_enabled*mining_weight*mining_reference)/max(0.001,gas_enabled*gas_weight+roof_enabled*roof_weight+water_enabled*water_weight+mining_enabled*mining_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "gas_factor",
      "label": "瓦斯及通风风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "gas_enabled*gas_reference*max(0,1+gas_elasticity*(production_pressure-1))/(1+gas_control*max(0,governance_level-1))",
      "measure": "核查通风系统、瓦斯抽采与监测联锁，异常时落实停产撤人和复查。"
    },
    {
      "name": "roof_factor",
      "label": "顶板支护风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "roof_enabled*roof_reference*max(0,1+roof_elasticity*(production_pressure-1))/(1+roof_control*max(0,governance_level-1))",
      "measure": "复核采掘扰动、支护设计和现场支护质量，及时处置顶板异常。"
    },
    {
      "name": "water_factor",
      "label": "水害风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "water_enabled*water_reference*max(0,1+water_elasticity*(production_pressure-1))/(1+water_control*max(0,governance_level-1))",
      "measure": "复核水文地质资料、探放水与排水能力，落实水害预警。"
    },
    {
      "name": "mining_factor",
      "label": "违规采掘风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "mining_enabled*mining_reference*max(0,1+mining_elasticity*(production_pressure-1))/(1+mining_control*max(0,governance_level-1))",
      "measure": "核查采掘边界、作业规程、生产组织及安全检查闭环。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(gas_weight*gas_factor+roof_weight*roof_factor+water_weight*water_factor+mining_weight*mining_factor)/max(0.001,gas_enabled*gas_weight+roof_enabled*roof_weight+water_enabled*water_weight+mining_enabled*mining_weight)+coupling*(gas_factor*mining_factor)"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "gas": "瓦斯及通风风险",
    "roof": "顶板支护风险",
    "water": "水害风险",
    "mining": "违规采掘风险"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
