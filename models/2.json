  "variables": [
    {
      "name": "hazard_pressure",
      "label": "隐患压力",
      "type": "stock",
      "role": "core",
      "unit": "归一化状态",
      "dimension": 0,
      "initial": "0.25+0.75*(stope_enabled*stope_weight*stope_reference+slope_enabled*slope_weight*slope_reference+drainage_enabled*drainage_weight*drainage_reference+blast_enabled*blast_weight*blast_reference+transport_enabled*transport_weight*transport_reference)/max(0.001,stope_enabled*stope_weight+slope_enabled*slope_weight+drainage_enabled*drainage_weight+blast_enabled*blast_weight+transport_enabled*transport_weight)",
      "rate": "hazard_formation-hazard_removal",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "cumulative_load",
      "label": "累计相对风险负荷",
      "type": "stock",
      "role": "core",
      "unit": "相对负荷",
      "dimension": 0,
      "initial": "0",
      "rate": "accident_intensity",
      "min": 0,
      "max": 100000000.0
    },
    {
      "name": "feedback_signal",
      "label": "滞后事故信息",
      "type": "stock",
      "role": "delay",
      "unit": "相对强度/月",
      "dimension": -1,
      "initial": "0",
      "rate": "(accident_intensity-feedback_signal)/response_time",
      "min": 0,
      "max": 1000000.0
    },
    {
      "name": "stope_factor",
      "label": "采空区与顶板风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "stope_enabled*stope_reference*max(0,1+stope_elasticity*(production_pressure-1))/(1+stope_control*max(0,governance_level-1))",
      "measure": "核查采空区处置、地压监测与巷道支护。"
    },
    {
      "name": "slope_factor",
      "label": "边坡稳定风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "slope_enabled*slope_reference*max(0,1+slope_elasticity*(production_pressure-1))/(1+slope_control*max(0,governance_level-1))",
      "measure": "核查边坡或坝体稳定、位移监测及排水条件。"
    },
    {
      "name": "drainage_factor",
      "label": "排水及水害风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "drainage_enabled*drainage_reference*max(0,1+drainage_elasticity*(production_pressure-1))/(1+drainage_control*max(0,governance_level-1))",
      "measure": "检查排水系统、水位监测与防汛应急能力。"
    },
    {
      "name": "blast_factor",
      "label": "爆破作业风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "blast_enabled*blast_reference*max(0,1+blast_elasticity*(production_pressure-1))/(1+blast_control*max(0,governance_level-1))",
      "measure": "核查爆破设计、警戒、盲炮处理和爆破器材管理。"
    },
    {
      "name": "transport_factor",
      "label": "运输提升风险",
      "type": "aux",
      "role": "factor",
      "unit": "相对量",
      "dimension": 0,
      "formula": "transport_enabled*transport_reference*max(0,1+transport_elasticity*(production_pressure-1))/(1+transport_control*max(0,governance_level-1))",
      "measure": "核查提升保护、运输线路、车辆维护与人车分流。"
    },
    {
      "name": "governance_level",
      "label": "安全治理水平",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "safety_effort*(1+hazard_response*hazard_pressure/(1+hazard_pressure)+feedback_gain*feedback_signal/(intensity_reference+feedback_signal))"
    },
    {
      "name": "factor_load",
      "label": "专业因素综合作用",
      "type": "aux",
      "unit": "相对量",
      "dimension": 0,
      "formula": "(stope_weight*stope_factor+slope_weight*slope_factor+drainage_weight*drainage_factor+blast_weight*blast_factor+transport_weight*transport_factor)/max(0.001,stope_enabled*stope_weight+slope_enabled*slope_weight+drainage_enabled*drainage_weight+blast_enabled*blast_weight+transport_enabled*transport_weight)+coupling*(drainage_factor*(stope_factor+slope_factor))"
    },
    {
      "name": "relative_exposure",
      "label": "危险作业相对暴露",
      "type": "aux",
      "unit": "倍",
      "dimension": 0,
      "formula": "exposure_scale*production_pressure**exposure_elasticity"
    },
    {
      "name": "hazard_formation",
      "label": "隐患形成速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "formation_rate*production_pressure*(1+factor_load)"
    },
    {
      "name": "hazard_removal",
      "label": "隐患消除速度",
      "type": "aux",
      "role": "flow",
      "unit": "归一化状态/月",
      "dimension": -1,
      "formula": "prevention_rate*governance_level*hazard_pressure"
    },
    {
      "name": "accident_intensity",
      "label": "相对事故强度",
      "type": "aux",
      "role": "flow",
      "unit": "相对强度/月",
      "dimension": -1,
      "formula": "intensity_scale*relative_exposure*hazard_pressure*(1+factor_load)"
    },
    {
      "name": "risk_index",
      "label": "综合风险指数",
      "type": "aux",
      "unit": "分",
      "dimension": 0,
      "formula": "100*accident_intensity/(intensity_reference+accident_intensity)"
    }
  ],
  "feature_labels": {
    "stope": "采空区与顶板风险",
    "slope": "边坡稳定风险",
    "drainage": "排水及水害风险",
    "blast": "爆破作业风险",
    "transport": "运输提升风险"
  },
  "quantity_mode": "relative",
  "count_calibration": null,
  "assumptions": {
    "time_unit": "月",
    "integration_step": 0.05,
    "coefficient_source": "明确机制假设；未冒充专家评审或回归结果",
    "index_conversion": "100 × 相对事故强度 ÷（固定半饱和强度 + 相对事故强度）",
    "initial_pressure": "0.25 + 0.75 × 适用行业因素参考值加权均值；不是实测隐患数量",
    "delay": "一阶信息平滑；初始新增事故信息为0，三个场景一致",
    "limitation": "当前结果为情景推演：隐患压力是模拟状态，事故强度为相对量；缺少完整事故口径、连续暴露量和经过验证的发生率，暂不预测事故起数。"
  }
}
