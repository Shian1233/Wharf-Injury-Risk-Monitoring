DB_BACKEND=sqlite
STORAGE_BACKEND=local
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=risk_agent
PG_USER=risk_app
PG_PASSWORD=
S3_ENDPOINT=127.0.0.1:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=risk-agent
S3_SECURE=false
S3_REGION=us-east-1
AUTH_MODE=local
# Run scripts/set_password.py or double-click 设置访问密码.cmd to enable password login.
APP_PASSWORD_HASH=
PUBLIC_BASE_PATH=
SESSION_SECRET=replace-with-at-least-32-random-characters
ROLE_TOKENS={"admin":"replace-admin-token","editor":"replace-editor-token","viewer":"replace-viewer-token"}
ALLOWED_ORIGINS=
PLATFORM_BASE_URL=
PLATFORM_JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Unified identity authentication (IDS6.0, CAS protocol). Only used when AUTH_MODE=cas.
CAS_SERVER_URL_PREFIX=
CAS_LOGIN_SUFFIX=login
CAS_VALIDATE_SUFFIX=serviceValidate
CAS_LOGOUT_SUFFIX=logout
# Callback URL that must also be registered as this application's service address in the IDS console.
CAS_SERVICE_URL=
CAS_SERVICE_ORIGIN=
CAS_SERVICE_HOSTS=
CAS_LOGOUT_SERVICE=
CAS_VERIFY_SSL=true
CAS_TIMEOUT=8
CAS_ENCODING=utf-8
# CAS_ATTR_ID=user uses <cas:user>; any other value names a CAS attribute.
CAS_ATTR_ID=user
CAS_ATTR_NAME=cn
CAS_DEFAULT_ROLE=viewer
CAS_SESSION_TTL=28800
CAS_NEXT_ALLOWLIST=
# global: logout also ends the IDS session, which signs the user out of every
# application on the same IDS. local: only clear this application's session.
CAS_LOGOUT_MODE=global
LLM_PROVIDER=DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Comma-separated enabled application model IDs from your connected provider.
LLM_MODELS=deepseek-flash,deepseek-v4-pro
LLM_API_KEY=
DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=RISK_AGENT
DM_PASSWORD=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=risk-agent
MINIO_SECURE=false
MAX_UPLOAD_BYTES=10737418240
# Optional browser executable. If empty, use Playwright-installed Chromium.
BROWSER_BINARY=
NODE_BINARY=
NODE_PATH=
