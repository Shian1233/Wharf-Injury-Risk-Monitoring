ROLE_TOKENS={"admin":"replace-admin-token","editor":"replace-editor-token","viewer":"replace-viewer-token"}
ALLOWED_ORIGINS=
PLATFORM_BASE_URL=
PLATFORM_JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
LLM_PROVIDER=DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Comma-separated enabled application model IDs from your connected provider.
LLM_MODELS=deepseek-flash,deepseek-v4-pro
LLM_API_KEY=
DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=RISK_AGENT
DM_PASSWORD=
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=risk-agent
MINIO_SECURE=false
MAX_UPLOAD_BYTES=10737418240
# Optional browser executable. If empty, use Playwright-installed Chromium.
BROWSER_BINARY=
NODE_BINARY=
NODE_PATH=
