DB_BACKEND=sqlite
STORAGE_BACKEND=local
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=risk_agent
PG_USER=risk_app
PG_PASSWORD=
S3_ENDPOINT=127.0.0.1:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=risk-agent
S3_SECURE=false
S3_REGION=us-east-1
AUTH_MODE=local
# Run scripts/set_password.py or double-click 设置访问密码.cmd to enable password login.
APP_PASSWORD_HASH=
PUBLIC_BASE_PATH=
